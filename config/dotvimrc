function! s:Absolute(path, root) abort
    return resolve(fnamemodify(a:path =~# '^\%(/\|\a:[/\\]\)' ? a:path : a:root . '/' . a:path, ':p'))
endfunction
function! s:DatabaseFile() abort
    let l:p = get(t:, 'portable_project', {})
    if has_key(l:p, 'compilation_database')
        return l:p.compilation_database . '/compile_commands.json'
    endif
    let l:root = get(l:p, 'root', expand('%:p:h'))
    while !empty(l:root)
        for l:path in [l:root . '/compile_commands.json', l:root . '/build/compile_commands.json']
            if filereadable(l:path)
                return l:path
            endif
        endfor
        let l:parent = fnamemodify(l:root, ':h')
        if l:parent ==# l:root
            break
        endif
        let l:root = l:parent
    endwhile
    throw 'Compilation database not found; use :BuildDatabase or select its directory'
endfunction
function! s:CompilationEntries() abort
    let l:path = s:DatabaseFile()
    if !filereadable(l:path)
        throw 'Compilation database not found: ' . l:path
    endif
    let l:db = json_decode(join(readfile(l:path), "\n"))
    if type(l:db) != v:t_list
        throw 'Compilation database must be a JSON array'
    endif
    let l:file = resolve(expand('%:p'))
    let l:entries = []
    for l:entry in l:db
        if type(l:entry) == v:t_dict && has_key(l:entry, 'directory') && has_key(l:entry, 'file')
            let l:entry = deepcopy(l:entry)
            let l:entry.directory = s:Absolute(l:entry.directory, fnamemodify(l:path, ':h'))
            if s:Absolute(l:entry.file, l:entry.directory) ==# l:file
                call add(l:entries, l:entry)
            endif
        endif
    endfor
    return l:entries
endfunction
if has('python3')
    " Keep Python indentation inside strings: gg=G must only indent Vimscript.
    let s:compilation_parser = join([
                \ 'import os as _portable_os',
                \ 'import shlex as _portable_shlex',
                \ '',
                \ 'def _portable_compilation_split(command):',
                \ '    if _portable_os.name != ''nt'':',
                \ '        return _portable_shlex.split(command)',
                \ '    import ctypes',
                \ '    from ctypes import wintypes',
                \ '    split = ctypes.windll.shell32.CommandLineToArgvW',
                \ '    split.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(ctypes.c_int)]',
                \ '    split.restype = ctypes.POINTER(wintypes.LPWSTR)',
                \ '    count = ctypes.c_int()',
                \ '    argv = split(command, ctypes.byref(count))',
                \ '    if not argv:',
                \ '        raise ValueError(''Invalid Windows compilation command'')',
                \ '    try:',
                \ '        return [argv[i] for i in range(count.value)]',
                \ '    finally:',
                \ '        free = ctypes.windll.kernel32.LocalFree',
                \ '        free.argtypes = [ctypes.c_void_p]',
                \ '        free.restype = ctypes.c_void_p',
                \ '        free(ctypes.cast(argv, ctypes.c_void_p))'
                \ ], "\n")
    execute 'python3 exec(' . json_encode(s:compilation_parser) . ')'
endif
function! s:CompilationArgv(entry) abort
    if has_key(a:entry, 'arguments')
        let l:args = copy(a:entry.arguments)
    elseif has_key(a:entry, 'command') && has('python3')
        " The database contains a command, not a script: tokenize, never eval.
        let l:args = py3eval('_portable_compilation_split(' . json_encode(a:entry.command) . ')')
    else
        throw 'Database requires arguments arrays, or command with Vim +python3'
    endif
    if type(l:args) != v:t_list || empty(l:args) || !empty(filter(copy(l:args), 'type(v:val) != v:t_string'))
        throw 'Invalid compilation argument list'
    endif
    if l:args[0] =~# '[/\\]'
        let l:args[0] = s:Absolute(l:args[0], a:entry.directory)
    else
        let l:args[0] = exepath(l:args[0])
    endif
    if empty(l:args[0]) || !executable(l:args[0])
        throw 'Compilation database compiler is unavailable'
    endif
    return l:args
endfunction
function! s:ProjectHealth() abort
    let l:p = get(t:, 'portable_project', {})
    let l:lines = ['Project: ' . get(l:p, 'name', '(none)'), 'Root: ' . get(l:p, 'root', getcwd()),
                \ 'Build: ' . get(l:p, 'build', &makeprg),
                \ 'Configured clangd: ' . get(g:, 'ycm_clangd_binary_path', '(YCM bundled)'),
                \ 'clangd args: ' . string(get(g:, 'ycm_clangd_args', [])),
                \ 'Vim Python3/job/channel: ' . has('python3') . '/' . has('job') . '/' . has('channel')]
    for l:tool in ['clang', 'clangd', 'rg', 'git', 'bear', 'cmake', 'make']
        call add(l:lines, l:tool . ': ' . (executable(l:tool) ? exepath(l:tool) : 'MISSING'))
    endfor
    try
        call add(l:lines, 'Database: ' . s:DatabaseFile())
        let l:entries = s:CompilationEntries()
        call add(l:lines, 'Current file compilation entries: ' . len(l:entries))
        for l:entry in l:entries[:4]
            let l:argv = s:CompilationArgv(l:entry)
            call add(l:lines, 'Compiler: ' . l:argv[0])
            call add(l:lines, 'Directory: ' . l:entry.directory)
            call add(l:lines, 'Arguments: ' . string(l:argv))
            call extend(l:lines, split(system(shellescape(l:argv[0]) . ' --version'), "\n")[:1])
        endfor
    catch
        call add(l:lines, 'Database check: ' . v:exception)
    endtry
    if exists(':YcmDebugInfo') == 2
        try
            call extend(l:lines, ['', 'Running YCM:'] + split(execute('silent YcmDebugInfo'), "\n"))
        catch
            call add(l:lines, 'YCM status: ' . v:exception)
        endtry
    else
        call add(l:lines, 'YCM command: MISSING')
    endif
    let g:portable_vim_health_report = copy(l:lines)
    call s:ShowReport('[Project Health]', l:lines, 'text')
endfunction
command! ProjectHealth call <SID>ProjectHealth()

function! s:InspectionOutput(channel, line) abort
    call add(s:inspection.lines, a:line)
endfunction
function! s:InspectionClosed(channel) abort
    let s:inspection.closed = 1
    call s:InspectionFinished()
endfunction
function! s:InspectionExited(job, status) abort
    let s:inspection.status = a:status
    call s:InspectionFinished()
endfunction
function! s:InspectionFinished() abort
    if !get(s:inspection, 'closed', 0) || !has_key(s:inspection, 'status')
        return
    endif
    let s:inspection.running = 0
    let g:portable_vim_inspection_result = {'status': s:inspection.status, 'source': s:inspection.source,
                \ 'argv': copy(s:inspection.argv), 'root': s:inspection.root, 'mode': s:inspection.mode,
                \ 'lines': copy(s:inspection.lines)}
    try
        if !s:inspection.status && filereadable(s:inspection.output)
            let l:lines = readfile(s:inspection.output)
            call s:ShowReport('[' . s:inspection.mode . ': ' . fnamemodify(s:inspection.source, ':t') . ']',
                        \ l:lines, s:inspection.mode ==# 'Preprocess' ? 'c' : 'asm')
        else
            call setqflist([], ' ', {'title': s:inspection.mode . ' failed',
                        \ 'lines': ['PORTABLE_BUILD_DIR:' . s:inspection.root] + s:inspection.lines,
                        \ 'efm': '%DPORTABLE_BUILD_DIR:%f,' . s:inspection.efm,
                        \ 'context': g:portable_vim_inspection_result})
            echom s:inspection.mode . ' failed: exit ' . s:inspection.status . ' (use :copen)'
        endif
    finally
        call delete(s:inspection.output)
    endtry
endfunction
function! s:InspectCompilation(mode, index) abort
    if !exists('*job_start') || get(s:inspection, 'running', 0)
        echoerr 'Inspection needs Vim +job and no running inspection'
        return
    endif
    if &buftype !=# '' || &filetype !~# '^\%(c\|cpp\)$'
        echoerr 'Open a C/C++ source file with a compilation database entry'
        return
    endif
    try
        let l:entries = s:CompilationEntries()
        let l:index = empty(a:index) ? 1 : str2nr(a:index)
        if a:index !~# '^\d*$' || l:index < 1 || l:index > len(l:entries)
            throw 'No matching compilation entry (index is 1-based)'
        endif
        let l:entry = l:entries[l:index - 1]
        let l:argv = s:CompilationArgv(l:entry)
        if fnamemodify(l:argv[0], ':t') !~# '\%(clang\|gcc\|g++\|cc\|c++\)\%(-\d\+\)\?\%(.exe\)\?$'
            throw 'Inspection supports direct GCC/Clang drivers; export unwrapped arguments'
        endif
        let l:clean = [l:argv[0]]
        let l:i = 1
        while l:i < len(l:argv)
            let l:arg = l:argv[l:i]
            if index(['-o', '--output', '-MF', '-MT', '-MQ', '-MJ', '--serialize-diagnostics', '-serialize-diagnostics'], l:arg) >= 0
                let l:i += 2
                continue
            elseif l:arg =~# '^@' || l:arg ==# '-Xclang' || l:arg ==# '-Xassembler' || l:arg ==# '-Xpreprocessor' || l:arg =~# '^-[Ww][pa],'
                throw 'Inspection requires expanded driver arguments (no response files or forwarded compiler/preprocessor options)'
            elseif l:arg =~# '^\%(-c\|-S\|-E\|-fsyntax-only\|-M\|-MM\|-MD\|-MMD\|-MP\|-MG\|--coverage\|-fprofile-arcs\|-ftest-coverage\)$'
                        \ || l:arg =~# '^\%(-o.\+\|-M[FQTJ].\+\|-save-temps\|-fprofile-.*generate\|-ftime-trace\|-fsave-optimization-record\|-foptimization-record-file=\|--output=\|--serialize-diagnostics=\)'
                let l:i += 1
                continue
            endif
            if a:mode ==# 'Assembly' && (l:arg =~# '^-flto' || l:arg ==# '-emit-llvm')
                let l:i += 1
                continue
            endif
            call add(l:clean, l:arg)
            let l:i += 1
        endwhile
        let l:output = tempname() . (a:mode ==# 'Preprocess' ? '.i' : '.s')
        call extend(l:clean, [a:mode ==# 'Preprocess' ? '-E' : '-S', '-fdiagnostics-color=never', '-o', l:output])
        let s:inspection = {'running': 1, 'closed': 0, 'argv': l:clean, 'root': l:entry.directory,
                    \ 'source': expand('%:p'), 'output': l:output, 'lines': [], 'mode': a:mode,
                    \ 'efm': get(get(t:, 'portable_project', {}), 'efm', &errorformat)}
        if &modified
            echom 'Inspection uses the saved file; buffer changes remain unsaved'
        endif
        let s:inspection.job = job_start(l:clean, {'cwd': l:entry.directory, 'in_io': 'null',
                    \ 'out_mode': 'nl', 'err_io': 'out', 'out_cb': function('<SID>InspectionOutput'),
                    \ 'close_cb': function('<SID>InspectionClosed'), 'exit_cb': function('<SID>InspectionExited')})
        if job_status(s:inspection.job) ==# 'fail'
            let s:inspection.running = 0
            call delete(l:output)
            throw 'Could not start compiler inspection'
        endif
    catch
        echoerr v:exception
    endtry
endfunction
command! -nargs=? Preprocess call <SID>InspectCompilation('Preprocess', <q-args>)
command! -nargs=? Assembly call <SID>InspectCompilation('Assembly', <q-args>)
function! s:InspectionStop() abort
    if get(s:inspection, 'running', 0)
        call job_stop(s:inspection.job)
    endif
endfunction
