" Portable Vim configuration: Linux / Windows / macOS, Vim 8.2+.
" Unix: ~/.vimrc; Windows: ~/_vimrc. Optional overrides: vimrc.local.
set nocompatible
set encoding=utf-8
scriptencoding utf-8
let s:windows = has('win32') || has('win64')
let s:mac = has('macunix')
if s:windows && filereadable($VIMRUNTIME . '/mswin.vim')
    execute 'source ' . fnameescape($VIMRUNTIME . '/mswin.vim')
    behave mswin
endif
let g:portable_vim_home = get(g:, 'portable_vim_home', expand(s:windows ? '~/vimfiles' : '~/.vim'))
let s:home = g:portable_vim_home
" Include the chosen user runtime even when launched with -u /path/dotvimrc.
if index(split(&runtimepath, ','), s:home) < 0
    execute 'set runtimepath^=' . escape(s:home, ' ,\\')
endif

" Adjacent packages travel with this configuration, including when using -u.
let s:config_dir = expand('<sfile>:p:h')
let s:packages = s:config_dir . '/.vim-pack'
if get(g:, 'portable_vim_plugins', 1) && isdirectory(s:packages) && index(split(&packpath, ','), s:packages) < 0
    let &packpath = escape(s:packages, ' ,\\') . ',' . &packpath
endif
if get(g:, 'portable_vim_plugins', 1)
            \ && (!empty(globpath(&packpath, 'pack/*/start/vim-fugitive', 0, 1))
            \     || !empty(globpath(&packpath, 'pack/*/opt/vim-fugitive', 0, 1)))
    packadd vim-fugitive
endif

" Encoding: BOM must precede UTF-8; new files use UTF-8 on every platform.
set encoding=utf-8
set fileencoding=utf-8
set fileencodings=ucs-bom,utf-8,gb18030,big5,latin1
set fileformats=unix,dos,mac
set fileformat=unix

" Fold entire Vim functions (including blank lines), without nested if folds.
let g:vimsyn_folding = get(g:, 'vimsyn_folding', 'f')

