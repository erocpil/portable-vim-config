function! s:BuildLog() abort
    if has_key(s:build, 'lines')
        let l:lines = copy(s:build.lines)
        let l:title = s:build.title
    elseif exists('g:portable_vim_build_result')
        let l:lines = copy(g:portable_vim_build_result.lines)
        let l:title = get(g:portable_vim_build_result, 'title', 'Build')
    else
        echoerr 'No build output; run :BuildAsync or :ProjectTask first'
        return
    endif
    call s:ShowReport('[Build Log: ' . l:title . ']', l:lines, 'text')
endfunction
function! s:BuildLogSave(path, force) abort
    if get(s:build, 'running', 0)
        echoerr 'Build is running; use :BuildLog to view output or wait before saving'
        return
    endif
    if !exists('g:portable_vim_build_result')
        echoerr 'No completed build to save'
        return
    endif
    let l:path = empty(a:path) ? get(get(t:, 'portable_project', {}), 'log_file', '') : a:path
    if empty(l:path)
        echoerr 'Specify a log file or set log_file in the project profile'
        return
    endif
    let l:path = fnamemodify(expand(l:path), ':p')
    if getftype(l:path) !=# '' && !a:force
        echoerr 'Log exists; use :BuildLogSave! to overwrite'
        return
    endif
    let l:log = deepcopy(g:portable_vim_build_result)
    let l:log.format = 'portable-vim-build-v1'
    if has_key(l:log, 'qfid')
        call remove(l:log, 'qfid')
    endif
    if !isdirectory(fnamemodify(l:path, ':h'))
        echoerr 'Build log parent directory does not exist: ' . fnamemodify(l:path, ':h')
        return
    endif
    let l:tmp = fnamemodify(l:path, ':h') . '/.vim-build-log-' . getpid() . '-' . fnamemodify(tempname(), ':t')
    try
        call writefile([json_encode(l:log)], l:tmp)
        call setfperm(l:tmp, filereadable(l:path) ? getfperm(l:path) : 'rw-------')
        if (!a:force && getftype(l:path) !=# '') || rename(l:tmp, l:path) != 0
            throw 'Could not replace build log; existing file preserved'
        endif
    finally
        call delete(l:tmp)
    endtry
    echom 'Build log saved: ' . l:path
endfunction
function! s:BuildLogLoad(path) abort
    let l:path = empty(a:path) ? get(get(t:, 'portable_project', {}), 'log_file', '') : a:path
    if empty(l:path)
        echoerr 'Specify a saved log file or set log_file; use :BuildLog for current output'
        return
    endif
    let l:path = fnamemodify(expand(l:path), ':p')
    if !filereadable(l:path)
        echoerr 'Build log does not exist: ' . l:path . '; save it with :BuildLogSave first'
        return
    endif
    let l:lines = readfile(l:path)
    if !empty(l:lines) && l:lines[0] =~# '^\s*{'
        try
            let l:log = json_decode(join(l:lines, "\n"))
        catch
            echoerr 'Invalid build log JSON'
            return
        endtry
        if type(l:log) != v:t_dict || get(l:log, 'format', '') !=# 'portable-vim-build-v1'
                    \ || type(get(l:log, 'lines', 0)) != v:t_list
                    \ || type(get(l:log, 'root', 0)) != v:t_string
                    \ || type(get(l:log, 'efm', 0)) != v:t_string
                    \ || !empty(filter(copy(get(l:log, 'lines', [])), 'type(v:val) != v:t_string'))
            echoerr 'Invalid portable build log'
            return
        endif
    else
        let l:p = get(t:, 'portable_project', {})
        let l:log = {'lines': l:lines, 'root': get(l:p, 'root', getcwd()),
                    \ 'efm': '%DPORTABLE_BUILD_DIR:%f,' . get(l:p, 'efm', &errorformat),
                    \ 'status': 'unknown', 'command': '', 'time': '', 'stopped': 0}
    endif
    call setqflist([], ' ', {'title': 'Build log: ' . l:path . ' [exit ' . get(l:log, 'status', 'unknown') . ']',
                \ 'lines': ['PORTABLE_BUILD_DIR:' . l:log.root] + l:log.lines,
                \ 'efm': l:log.efm, 'context': l:log})
    call s:OpenQuickfixInCodeArea()
endfunction
