function! s:ProjectNames(A, L, P) abort
    return join(sort(keys(g:portable_vim_projects)), "\n")
endfunction
function! s:ApplyProjectBackend(profile) abort
    if !exists('s:project_ycm_defaults')
        let s:project_ycm_defaults = {'clangd': get(g:, 'ycm_clangd_binary_path', ''),
                    \ 'args': copy(get(g:, 'ycm_clangd_args', []))}
    endif
    let g:ycm_clangd_binary_path = get(a:profile, 'clangd', s:project_ycm_defaults.clangd)
    let g:ycm_clangd_args = copy(get(a:profile, 'clangd_args', s:project_ycm_defaults.args))
    if has_key(a:profile, 'compilation_database')
        call filter(g:ycm_clangd_args, 'v:val !~# "^--compile-commands-dir="')
        call add(g:ycm_clangd_args, '--compile-commands-dir=' . a:profile.compilation_database)
    endif
    echom 'Use :YcmRestartServer to apply clangd settings (YCM server is shared)'
endfunction
function! s:Project(name) abort
    if !has_key(g:portable_vim_projects, a:name)
        echoerr 'Unknown project profile: ' . a:name
        return
    endif
    let l:p = deepcopy(g:portable_vim_projects[a:name])
    if empty(get(l:p, 'root', '')) || empty(get(l:p, 'build', ''))
        echoerr 'Project requires root and build'
        return
    endif
    let l:p.root = fnamemodify(expand(l:p.root), ':p')
    if !isdirectory(l:p.root)
        echoerr 'Project root does not exist: ' . l:p.root
        return
    endif
    if has_key(l:p, 'clangd') && !executable(l:p.clangd)
        echoerr 'clangd is unavailable: ' . l:p.clangd
        return
    endif
    if has_key(l:p, 'compilation_database')
        let l:db = expand(l:p.compilation_database)
        let l:p.compilation_database = fnamemodify(l:db =~# '^\%(/\|\a:[/\\]\)' ? l:db : l:p.root . '/' . l:db, ':p')
        if !isdirectory(l:p.compilation_database)
            echoerr 'Compilation database directory does not exist: ' . l:p.compilation_database
            return
        endif
    endif
    execute 'lcd ' . fnameescape(l:p.root)
    compiler gcc
    let &l:makeprg = l:p.build
    let l:p.efm = get(l:p, 'errorformat', &errorformat)
    let &l:errorformat = l:p.efm
    let l:p.name = a:name
    let t:portable_project = l:p
    call s:ApplyProjectBackend(l:p)
    echom 'Project: ' . a:name . ' (' . l:p.root . ')'
endfunction
command! -nargs=1 -complete=custom,<SID>ProjectNames Project call <SID>Project(<q-args>)

" Open reports and quickfix below the main editing area.  Commands such as
" :copen split the current window, which makes results unusably narrow when
" invoked from NERDTree, Tagbar, a terminal, or another auxiliary pane.
function! s:IsCodeAreaWindow(winid) abort
    let l:buf = winbufnr(a:winid)
    if l:buf < 0 || getbufvar(l:buf, '&buftype') !=# ''
                \ || getwinvar(win_id2win(a:winid), '&previewwindow')
                \ || getbufvar(l:buf, 'portable_practice_id', 0)
        return 0
    endif
    let l:ft = getbufvar(l:buf, '&filetype')
    let l:name = bufname(l:buf)
    if index(['nerdtree', 'tagbar', 'taglist', 'netrw', 'bufexplorer',
                \ 'fugitive', 'fugitiveblame', 'git', 'gitrebase'], l:ft) >= 0
                \ || l:name =~# '^\%(__Tagbar__\.\|NERD_tree_\)'
        return 0
    endif
    return 1
endfunction

function! s:FocusCodeArea() abort
    if s:IsCodeAreaWindow(win_getid())
        return 1
    endif
    let l:best = 0
    let l:best_area = -1
    for l:win in getwininfo()
        if l:win.tabnr != tabpagenr() || !s:IsCodeAreaWindow(l:win.winid)
            continue
        endif
        let l:area = l:win.width * l:win.height
        if l:area > l:best_area
            let l:best = l:win.winid
            let l:best_area = l:area
        endif
    endfor
    return l:best ? win_gotoid(l:best) : 0
endfunction

function! s:OpenQuickfixInCodeArea() abort
    call s:FocusCodeArea()
    " Vim may otherwise fill the space below a right-hand NERDTree even when
    " the code window is current.  A full-width bottom list remains readable.
    botright copen
endfunction

