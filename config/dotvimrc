function! s:BuildOutput(channel, message) abort
    call add(s:build.lines, a:message)
    if getqflist({'id': s:build.qfid, 'nr': 0}).nr
        call setqflist([], 'a', {'id': s:build.qfid, 'lines': [a:message], 'efm': s:build.efm})
    endif
endfunction
function! s:BuildClosed(channel) abort
    let s:build.closed = 1
    call s:BuildFinished()
endfunction
function! s:BuildExited(job, status) abort
    let s:build.status = a:status
    call s:BuildFinished()
endfunction
function! s:BuildFinished() abort
    if !get(s:build, 'closed', 0) || !has_key(s:build, 'status')
        return
    endif
    let g:portable_vim_build_result = {'status': s:build.status, 'root': s:build.root,
                \ 'lines': copy(s:build.lines), 'qfid': s:build.qfid,
                \ 'stopped': get(s:build, 'stopped', 0), 'command': s:build.command,
                \ 'efm': s:build.efm, 'title': s:build.title, 'time': s:build.time}
    " Reparse together to preserve multiline diagnostics and directory context.
    if getqflist({'id': s:build.qfid, 'nr': 0}).nr
        call setqflist([], 'r', {'id': s:build.qfid,
                    \ 'lines': ['PORTABLE_BUILD_DIR:' . s:build.root] + s:build.lines,
                    \ 'efm': s:build.efm, 'title': s:build.title . ' [exit ' . s:build.status . ']',
                    \ 'context': g:portable_vim_build_result})
    endif
    let s:build.running = 0
    echom 'Build finished: exit ' . s:build.status . ' (use :BuildResults)'
    if has_key(s:build, 'on_complete')
        call call(s:build.on_complete, [deepcopy(g:portable_vim_build_result)])
    endif
endfunction
function! s:StartBuild(cmd, root, efm, title, ...) abort
    if get(s:build, 'running', 0)
        echoerr 'A build is already running; use :BuildStop first'
        return
    endif
    if !exists('*job_start')
        echoerr 'Asynchronous builds require Vim +job and +channel'
        return
    endif
    let l:title = a:title
    let l:root = a:root
    let l:cmd = a:cmd
    call setqflist([], ' ', {'title': l:title, 'items': []})
    let s:build = {'running': 1, 'closed': 0, 'root': l:root, 'title': l:title,
                \ 'efm': '%DPORTABLE_BUILD_DIR:%f,' . a:efm,
                \ 'command': l:cmd, 'time': strftime('%Y-%m-%dT%H:%M:%S%z'),
                \ 'lines': [], 'qfid': getqflist({'id': 0}).id}
    let l:options = a:0 ? a:1 : {}
    if has_key(l:options, 'on_complete')
        let s:build.on_complete = l:options.on_complete
    endif
    call setqflist([], 'a', {'id': s:build.qfid,
                \ 'lines': ['PORTABLE_BUILD_DIR:' . l:root], 'efm': s:build.efm})
    let l:argv = get(l:options, 'argv', [&shell] + split(&shellcmdflag) + [l:cmd])
    let s:build.job = job_start(l:argv, {'cwd': l:root, 'in_io': 'null',
                \ 'out_mode': 'nl', 'err_io': 'out', 'out_cb': function('<SID>BuildOutput'),
                \ 'close_cb': function('<SID>BuildClosed'), 'exit_cb': function('<SID>BuildExited')})
    if job_status(s:build.job) ==# 'fail'
        let s:build.running = 0
        echoerr 'Could not start build'
    endif
endfunction
function! s:BuildAsync(args, database) abort
    let l:p = get(t:, 'portable_project', {})
    if a:database && (empty(l:p) || empty(get(l:p, 'database_command', '')))
        echohl WarningMsg
        if empty(l:p)
            echom 'BuildDatabase: no project selected in this tab; source a project profile, then use :Project <name>'
        else
            echom 'BuildDatabase: project ' . get(l:p, 'name', '(unnamed)') . ' has no database_command; add it to the profile and select :Project <name> again'
        endif
        echohl None
        return
    endif
    " Use effective global-local options: an empty local value inherits the global one.
    let l:cmd = a:database ? get(l:p, 'database_command', '') : get(l:p, 'build', &makeprg)
    if empty(l:cmd)
        echoerr 'Set makeprg or select a project with :Project'
        return
    endif
    if !empty(a:args)
        let l:cmd .= ' ' . a:args
    endif
    call s:StartBuild(l:cmd, get(l:p, 'root', getcwd()), get(l:p, 'efm', &errorformat),
                \ (a:database ? 'Database: ' : 'Build: ') . l:cmd)
endfunction
function! s:BuildStop() abort
    if get(s:build, 'running', 0)
        let s:build.stopped = 1
        call job_stop(s:build.job)
    endif
endfunction
function! s:BuildResults() abort
    let l:id = get(s:build, 'qfid', 0)
    let l:nr = l:id ? getqflist({'id': l:id, 'nr': 0}).nr : 0
    if !l:nr && has_key(s:build, 'lines')
        call setqflist([], ' ', {'title': s:build.title, 'efm': s:build.efm,
                    \ 'lines': ['PORTABLE_BUILD_DIR:' . s:build.root] + s:build.lines,
                    \ 'context': get(g:, 'portable_vim_build_result', {})})
        let s:build.qfid = getqflist({'id': 0}).id
        let l:nr = getqflist({'nr': 0}).nr
    elseif !l:nr
        echoerr 'Build list is unavailable'
        return
    endif
    let l:current = getqflist({'nr': 0}).nr
    if l:current > l:nr
        execute 'colder ' . (l:current - l:nr)
    elseif l:current < l:nr
        execute 'cnewer ' . (l:nr - l:current)
    endif
    call s:OpenQuickfixInCodeArea()
endfunction
command! -nargs=* BuildAsync call <SID>BuildAsync(<q-args>, 0)
command! BuildDatabase call <SID>BuildAsync('', 1)
command! BuildStop call <SID>BuildStop()
command! BuildResults call <SID>BuildResults()
