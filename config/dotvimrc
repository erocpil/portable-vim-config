" Tagbar (preservim/tagbar): requires compatible ctags.
" Left symbol outline, sorted and compact; opening does not steal focus.
let g:tagbar_left = 1
let g:tagbar_width = 30
let g:tagbar_compact = 1
let g:tagbar_sort = 1
let g:tagbar_systemenc = 'utf-8'
let g:tagbar_autofocus = 0
let g:tagbar_indent = 1
" Tagbar calls this hook on WinEnter/WinLeave.  Use the compact custom layout
" only while Tagbar has focus; otherwise retain Tagbar's stock inactive line.
function! PortableTagbarStatusline(active, sort, filename, flags) abort
    if a:active
        let l:flags = empty(a:flags) ? '' : ' [' . join(a:flags, '') . ']'
        let l:right = ' ' . a:sort . l:flags . ' '
        return '%#TagbarStatusTitle#[Tagbar] %#TagbarStatusFill#%='
                    \ . '%#TagbarStatusMode#' . l:right
    endif
    let l:flags = empty(a:flags) ? '' : '[' . join(a:flags, '') . '] '
    return '%#StatusLineNC#[' . a:sort . '] ' . l:flags
endfunction
let g:tagbar_status_func = 'PortableTagbarStatusline'

" Tagbar's QuitPre cleanup does not run when :q closes a source window while
" another tab page remains.  Defer the check until Vim has selected Tagbar;
" close only a tab page whose sole remaining window is the Tagbar buffer.
function! s:CloseOrphanTagbar(tabnr, winid, timer) abort
    if tabpagenr('$') <= 1 || empty(getwininfo(a:winid))
        return
    endif
    let l:info = getwininfo(a:winid)[0]
    if l:info.tabnr != a:tabnr || len(tabpagebuflist(a:tabnr)) != 1
        return
    endif
    let l:buf = winbufnr(a:winid)
    if getbufvar(l:buf, '&filetype') ==# 'tagbar'
                \ || bufname(l:buf) =~# '^__Tagbar__\.'
        execute 'silent! tabclose ' . a:tabnr
    endif
endfunction
function! s:ScheduleOrphanTagbarClose() abort
    if exists('*timer_start') && winnr('$') == 1 && tabpagenr('$') > 1
        call timer_start(0, function('<SID>CloseOrphanTagbar',
                    \ [tabpagenr(), win_getid()]))
    endif
endfunction
augroup PortableVimTagbarLifecycle
    autocmd!
    autocmd WinEnter __Tagbar__.* call <SID>ScheduleOrphanTagbarClose()
augroup END

