" Legacy NFO artwork uses CP437; reload only unmodified, non-binary buffers.
function! s:NfoEncoding() abort
    if &l:fileencoding !=# 'cp437' && !&modified && !&binary
        try
            execute 'keepalt edit ++enc=cp437 ' . fnameescape(expand('%:p'))
        catch
            echohl WarningMsg | echom 'CP437 decoding unavailable: ' . v:exception | echohl None
        endtry
    endif
endfunction
function! CheckFileEncoding() abort
    " The original e! on modified txt buffers discarded user edits.
    if &modified
        echohl WarningMsg | echom 'Modified text buffer: encoding reload skipped' | echohl None
    endif
endfunction
function! s:ReloadEncoding(encoding) abort
    if &modified
        echoerr 'Save or discard changes before reloading the encoding'
        return
    endif
    if a:encoding !~# '^[A-Za-z0-9_-]\+$' || empty(expand('%:p'))
        echoerr 'Specify an encoding and an existing file'
        return
    endif
    execute 'edit ++enc=' . a:encoding . ' ' . fnameescape(expand('%:p'))
endfunction
