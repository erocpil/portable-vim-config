" Read-only hover information. No translation or external network requests.
" Arguments make the formatter usable independently of the mouse event.
function! PortableVimBalloon(bufnr, winnr, lnum, col, word) abort
    if !bufexists(a:bufnr)
        return ''
    endif
    let l:lines = []
    " foldclosed() and spell checks depend on the current window options.
    " Never switch windows inside balloonexpr (Vim's textlock).
    if a:bufnr == bufnr('%') && a:winnr == winnr()
        let l:first = foldclosed(a:lnum)
        if l:first >= 0
            let l:last = foldclosedend(a:lnum)
            if l:last - l:first + 1 <= 31
                let l:lines = getbufline(a:bufnr, l:first, l:last)
            else
                let l:lines = getbufline(a:bufnr, l:first, l:first + 14)
                call add(l:lines, '-- Snipped ' . (l:last - l:first + 1 - 30) . ' lines --')
                call extend(l:lines, getbufline(a:bufnr, l:last - 14, l:last))
            endif
            return join(l:lines, has('balloon_multiline') ? "\n" : ' ')
        endif
        " Spelling is opt-in via :setlocal spell; no spell defaults are set.
        if &l:spell && !empty(a:word) && !empty(spellbadword(a:word)[0])
            let l:suggestions = spellsuggest(a:word, 5)
            if !empty(l:suggestions)
                return join(l:suggestions, has('balloon_multiline') ? "\n" : ' ')
            endif
            return ''
        elseif exists('*BalloonDeclaration') && v:beval_bufnr == a:bufnr
                    \ && v:beval_winnr + 1 == a:winnr && v:beval_lnum == a:lnum
                    \ && v:beval_col == a:col && v:beval_text ==# a:word
            " Preserve echofunc's original declaration lookup for real hover events.
            try
                return BalloonDeclaration()
            catch /^Vim\%((\a\+)\)\=:E/
                " Fall back to tags if the optional declaration plugin fails.
            endtry
        endif
    endif
    if !empty(a:word)
        " Use the hovered buffer's tags, even if it is not the current buffer.
        let l:tags = getbufvar(a:bufnr, '&tags')
        if a:bufnr == bufnr('%') || l:tags ==# &l:tags
            try
                let l:matches = taglist('^' . escape(a:word, '\.^$~[]*') . '$', bufname(a:bufnr))
                for l:tag in l:matches[:2]
                    call add(l:lines, printf('Tag: %s %s — %s',
                                \ get(l:tag, 'kind', ''), l:tag.name, l:tag.filename))
                    if has_key(l:tag, 'signature')
                        call add(l:lines, l:tag.signature)
                    endif
                endfor
            catch /^Vim\%((\a\+)\)\=:E/
                " Missing/stale tag files must not break hover information.
            endtry
        endif
    endif
    return join(l:lines, "\n")
endfunction
