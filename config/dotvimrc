" Compile first; run only on success. Separate scratch output avoids shell injection.
function! PortableVimCompileRun(cpp) abort
    if empty(expand('%:p')) || &buftype !=# ''
        echoerr 'Save a source file before compiling'
        return
    endif
    let l:compiler = a:cpp ? 'g++' : 'gcc'
    if !executable(l:compiler)
        let l:compiler = a:cpp ? 'clang++' : 'clang'
    endif
    if !executable(l:compiler)
        echoerr 'No C/C++ compiler is available in PATH'
        return
    endif
    write
    let l:source = expand('%:p')
    let l:dir = tempname()
    call mkdir(l:dir)
    let l:exe = l:dir . (s:windows ? '/program.exe' : '/program')
    try
        let l:output = system(shellescape(l:compiler) . ' ' . shellescape(l:source)
                    \ . ' -o ' . shellescape(l:exe) . ' 2>&1')
        let l:status = v:shell_error
        if l:status == 0
            let l:output .= system(shellescape(l:exe) . ' 2>&1')
            let l:status = v:shell_error
        endif
        botright new
        setlocal buftype=nofile bufhidden=wipe noswapfile
        call setline(1, [printf('Compile/run exit status: %d', l:status)] + split(l:output, "\n", 1))
        setlocal nomodifiable nomodified
    finally
        call delete(l:exe)
        call delete(l:dir, 'd')
    endtry
endfunction
nnoremap <C-F5> :call PortableVimCompileRun(0)<CR>
nnoremap <C-F6> :call PortableVimCompileRun(1)<CR>

