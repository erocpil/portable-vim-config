function! s:Session(path, save, force) abort
    let l:path = empty(a:path) ? get(get(t:, 'portable_project', {}), 'session', '') : a:path
    if empty(l:path)
        echoerr 'Specify a session file or set session in the project profile'
        return
    endif
    let l:path = fnamemodify(expand(l:path), ':p')
    if a:save
        if getftype(l:path) !=# '' && !a:force
            echoerr 'Session exists; use :SaveSession! to overwrite'
            return
        endif
        if !isdirectory(fnamemodify(l:path, ':h'))
            echoerr 'Session parent directory does not exist'
            return
        endif
        let l:old = &sessionoptions
        let l:previous = v:this_session
        let l:committed = 0
        " Stage beside the destination so rename does not cross filesystems.
        let l:tmp = fnamemodify(l:path, ':h') . '/.vim-session-' . getpid() . '-' . fnamemodify(tempname(), ':t') . '.vim'
        try
            let &sessionoptions = 'buffers,curdir,folds,tabpages,winsize'
            execute 'mksession ' . fnameescape(l:tmp)
            let l:profiles = []
            for l:tab in range(1, tabpagenr('$'))
                let l:p = gettabvar(l:tab, 'portable_project', {})
                if !empty(l:p)
                    call add(l:profiles, 'call settabvar(' . l:tab . ', "portable_project", ' . string(l:p) . ')')
                endif
            endfor
            call writefile(l:profiles, l:tmp, 'a')
            call setfperm(l:tmp, filereadable(l:path) ? getfperm(l:path) : 'rw-------')
            if (!a:force && getftype(l:path) !=# '') || rename(l:tmp, l:path) != 0
                throw 'Could not replace session file; existing session preserved'
            endif
            let l:committed = 1
            let v:this_session = l:path
            echom 'Session saved: ' . l:path
        finally
            let &sessionoptions = l:old
            if !l:committed
                let v:this_session = l:previous
            endif
            call delete(l:tmp)
        endtry
    else
        if !empty(getbufinfo({'bufmodified': 1}))
            echoerr 'Save or discard modified buffers before loading a session'
            return
        endif
        if !filereadable(l:path)
            echoerr 'Session file does not exist: ' . l:path
            return
        endif
        execute 'source ' . fnameescape(l:path)
        if exists('t:portable_project') && !empty(t:portable_project)
            let &l:makeprg = t:portable_project.build
            let &l:errorformat = t:portable_project.efm
            call s:ApplyProjectBackend(t:portable_project)
        endif
        echom 'Session loaded: ' . l:path
    endif
endfunction
" :SaveSession /path/work.vim saves views; :SaveSession! replaces it.
" :LoadSession /path/work.vim restores views; omitted path uses project.session.
" Source buffers are never saved here; save/discard edits before loading.
command! -bang -nargs=? -complete=file SaveSession call <SID>Session(<q-args>, 1, <bang>0)
command! -nargs=? -complete=file LoadSession call <SID>Session(<q-args>, 0, 0)

