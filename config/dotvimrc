" Binary hex mode uses a temporary buffer and Vim's normal writebackup path.
" Failed decoding never overwrites the target; the visible hex buffer is preserved.
function! s:HexRead() abort
    if !executable('xxd') || !filereadable(expand('%:p'))
        return
    endif
    let l:hex = system('xxd ' . shellescape(expand('%:p')))
    if v:shell_error
        echoerr 'xxd failed to read this file'
        return
    endif
    call setline(1, split(l:hex, "\n"))
    if line('$') > len(split(l:hex, "\n")) && !empty(l:hex)
        call deletebufline('%', len(split(l:hex, "\n")) + 1, '$')
    endif
    setlocal binary filetype=xxd nomodified
    let b:portable_hex = 1
endfunction
function! s:HexWrite(target) abort
    if !get(b:, 'portable_hex', 0)
        execute 'noautocmd write ' . fnameescape(a:target)
        return
    endif
    if &readonly
        echoerr 'Binary buffer is readonly'
        return
    endif
    " xxd -r silently skips malformed lines: reject them before decoding.
    for l:line in getline(1, '$')
        if !empty(l:line) && l:line !~# '^\x\{8,}: \%([0-9A-Fa-f ]\)\{1,40}\%($\|  \)'
            echoerr 'Malformed xxd line; binary file was not written'
            return
        endif
    endfor
    let l:tmp = tempname()
    let l:origin = win_getid()
    let l:buffer = bufnr('%')
    let l:name = bufname('%')
    let l:modified = &modified
    let l:written = 0
    let l:renamed = 0
    let l:scratch = -1
    try
        call system('xxd -r > ' . shellescape(l:tmp), join(getline(1, '$'), "\n") . "\n")
        if v:shell_error
            throw 'xxd decoding failed'
        endif
        " An isolated raw buffer preserves the visible hex buffer's undo history.
        execute 'silent noautocmd keepalt file ' . fnameescape(l:tmp . '.hex')
        let l:renamed = 1
        noautocmd keepalt botright new
        execute 'silent noautocmd keepalt edit ++bin ' . fnameescape(l:tmp)
        let l:scratch = bufnr('%')
        setlocal binary nofixendofline noswapfile
        if filereadable(a:target) && filewritable(a:target) != 1
            throw 'Binary target is not writable'
        endif
        execute 'silent noautocmd write! ' . fnameescape(a:target)
        let l:written = 1
    finally
        if l:scratch >= 0 && bufexists(l:scratch)
            execute 'silent noautocmd bwipeout! ' . l:scratch
        endif
        noautocmd call win_gotoid(l:origin)
        if l:renamed
            execute 'silent noautocmd keepalt file ' . fnameescape(l:name)
        endif
        call setbufvar(l:buffer, '&modified', l:written ? 0 : l:modified)
        call delete(l:tmp)
    endtry
endfunction

