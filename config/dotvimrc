function! s:SearchFinished() abort
    if !get(s:search, 'closed', 0) || !has_key(s:search, 'status')
        return
    endif
    let s:search.running = 0
    let g:portable_vim_search_result = {'status': s:search.status, 'root': s:search.root,
                \ 'query': s:search.query, 'lines': copy(s:search.lines), 'qfid': s:search.qfid}
    if getqflist({'id': s:search.qfid, 'nr': 0}).nr
        call setqflist([], 'r', {'id': s:search.qfid,
                    \ 'lines': ['PORTABLE_BUILD_DIR:' . s:search.root] + s:search.lines,
                    \ 'efm': '%DPORTABLE_BUILD_DIR:%f,%f:%l:%c:%m',
                    \ 'title': 'Search: ' . s:search.query . ' [exit ' . s:search.status . ']',
                    \ 'context': g:portable_vim_search_result})
    endif
    echom s:search.status == 1 ? 'Search finished: no matches' : 'Search finished: exit ' . s:search.status . ' (use :SearchResults)'
endfunction
function! s:ProjectSearch(query, c_only, literal) abort
    if !executable('rg') || !exists('*job_start')
        echoerr 'Project search requires ripgrep and Vim +job'
        return
    endif
    if get(s:search, 'running', 0)
        echoerr 'A search is running; use :SearchStop first'
        return
    endif
    if empty(a:query)
        echoerr 'Specify a search pattern'
        return
    endif
    let l:p = get(t:, 'portable_project', {})
    let l:argv = [exepath('rg'), '--vimgrep', '--no-heading', '--color=never', '--smart-case']
    if a:c_only
        call extend(l:argv, ['-g', '*.c', '-g', '*.h'])
    endif
    if a:literal
        call extend(l:argv, ['--fixed-strings', '--word-regexp'])
    endif
    for l:glob in get(l:p, 'search_globs', [])
        call extend(l:argv, ['-g', l:glob])
    endfor
    call extend(l:argv, ['--', a:query, '.'])
    call setqflist([], ' ', {'title': 'Search: ' . a:query, 'items': []})
    let s:search = {'running': 1, 'closed': 0, 'query': a:query, 'root': get(l:p, 'root', getcwd()),
                \ 'qfid': getqflist({'id': 0}).id, 'lines': []}
    let s:search.job = job_start(l:argv, {'cwd': s:search.root, 'in_io': 'null',
                \ 'out_mode': 'nl', 'err_io': 'out', 'out_cb': function('<SID>SearchOutput'),
                \ 'close_cb': function('<SID>SearchClosed'), 'exit_cb': function('<SID>SearchExited')})
    if job_status(s:search.job) ==# 'fail'
        let s:search.running = 0
        echoerr 'Could not start search'
    endif
endfunction
function! s:SearchStop() abort
    if get(s:search, 'running', 0)
        call job_stop(s:search.job)
    endif
endfunction
function! s:SearchResults() abort
    let l:id = get(s:search, 'qfid', 0)
    let l:nr = l:id ? getqflist({'id': l:id, 'nr': 0}).nr : 0
    if !l:nr && has_key(s:search, 'lines')
        call setqflist([], ' ', {'title': 'Search: ' . s:search.query,
                    \ 'lines': ['PORTABLE_BUILD_DIR:' . s:search.root] + s:search.lines,
                    \ 'efm': '%DPORTABLE_BUILD_DIR:%f,%f:%l:%c:%m',
                    \ 'context': get(g:, 'portable_vim_search_result', {})})
        let s:search.qfid = getqflist({'id': 0}).id
        let l:nr = getqflist({'nr': 0}).nr
    elseif !l:nr
        echoerr 'Search list is unavailable'
        return
    endif
    let l:current = getqflist({'nr': 0}).nr
    if l:current > l:nr
        execute 'colder ' . (l:current - l:nr)
    elseif l:current < l:nr
        execute 'cnewer ' . (l:nr - l:current)
    endif
    call s:OpenQuickfixInCodeArea()
endfunction
