let g:ycm_echo_current_diagnostic = 1
let g:ycm_update_diagnostics_in_insert_mode = 0
let g:ycm_min_num_identifier_candidate_chars = 2
let g:ycm_collect_identifiers_from_comments_and_strings = 1
let g:ycm_filetype_whitelist = {'c': 1, 'cpp': 1, 'go': 1}
let g:ycm_semantic_triggers = {'c': ['->', '.', 're!\w{2}']}
let g:ycm_enable_diagnostic_signs = 1
let g:ycm_enable_diagnostic_highlighting = 1
let g:ycm_server_log_level = 'info'
" This YCM version needs an explicit clangd path; honor preexisting overrides.
if !exists('g:ycm_clangd_binary_path') && executable('clangd')
    let g:ycm_clangd_binary_path = exepath('clangd')
