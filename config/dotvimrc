" Unicode-safe clickable tab labels and real-path GUI metadata.
" The maintained dotvimrc places fold starts and their closing commands in
" column one. Cache its fold ranges per edit instead of scanning Vim syntax.
function! s:ConfigFold(lnum) abort
    if get(b:, 'portable_config_fold_tick', -1) != b:changedtick
        let l:lines = getline(1, '$')
        let l:levels = repeat([0], len(l:lines))
        let l:closing = {'function': 'endfunction', 'if': 'endif',
                    \ 'for': 'endfor', 'while': 'endwhile', 'try': 'endtry'}
        let l:start = -1
        let l:end = ''
        for l:index in range(len(l:lines))
            let l:text = l:lines[l:index]
            let l:word = matchstr(l:text, '^\h\w*')
            if l:start < 0
                if has_key(l:closing, l:word)
                    let l:end = l:closing[l:word]
                    if l:text !~# '|\s*' . l:end . '\>'
                        let l:start = l:index
                    endif
                endif
            elseif l:word ==# l:end
                let l:levels[l:start] = '>1'
                for l:inner in range(l:start + 1, l:index - 1)
                    let l:levels[l:inner] = 1
                endfor
                let l:levels[l:index] = '<1'
                let l:start = -1
            endif
        endfor
        let b:portable_config_fold_levels = l:levels
        let b:portable_config_fold_tick = b:changedtick
    endif
    return b:portable_config_fold_levels[a:lnum - 1]
endfunction

" Keep Vim's function syntax folds; add column-zero control blocks separately.
function! s:VimFolds() abort
    if resolve(expand('%:p')) ==# resolve(fnamemodify(g:portable_vim_config_file, ':p'))
        let &l:foldexpr = expand('<SID>') . 'ConfigFold(v:lnum)'
        setlocal foldmethod=expr foldtext=foldtext() foldnestmax=1
        return
    endif
    setlocal foldmethod=syntax foldtext=foldtext() foldnestmax=1
    silent! syntax clear PortableVimIfFold PortableVimForFold PortableVimWhileFold PortableVimTryFold
    syntax region PortableVimIfFold transparent fold keepend start="^if\>" end="^endif\>" contains=TOP
    syntax region PortableVimForFold transparent fold keepend start="^for\>" end="^endfor\>" contains=TOP
    syntax region PortableVimWhileFold transparent fold keepend start="^while\>" end="^endwhile\>" contains=TOP
    syntax region PortableVimTryFold transparent fold keepend start="^try\>" end="^endtry\>" contains=TOP
    syntax sync fromstart
endfunction

function! ShortTabLine() abort
    let l:result = ''
    for l:n in range(1, tabpagenr('$'))
        let l:buf = tabpagebuflist(l:n)[tabpagewinnr(l:n) - 1]
        let l:name = fnamemodify(bufname(l:buf), ':t')
        let l:name = empty(l:name) ? 'noname' : l:name
        let l:name = strchars(l:name) >= 8 ? strcharpart(l:name, 0, 6) . '..' : l:name
        let l:name = substitute(l:name, '%', '%%', 'g')
        let l:result .= (l:n == tabpagenr() ? '%#ErrorMsg#' : '%#TabLine#')
                    \ . '%' . l:n . 'T[' . l:name . ']'
    endfor
    return l:result . '%#TabLineFill#%T'
endfunction
