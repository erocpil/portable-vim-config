nnoremap <leader>ms :BuildStop<CR>
nnoremap <leader>mq :BuildResults<CR>

" Single-file exercises: saved source only, direct compiler argv, temporary output.
let s:practice = get(s:, 'practice', {})
let s:practice_windows = get(s:, 'practice_windows', {})
let s:practice_active_window = win_getid()
" One pane per source window; each run keeps a distinct terminal buffer.
" History is session-only and includes programs that actually started.
let s:practice_history = get(s:, 'practice_history', [])
let s:practice_next_id = get(s:, 'practice_next_id', 1)
let g:portable_practice_history_limit = get(g:, 'portable_practice_history_limit', 10)
" Evaluate in the statusline's window; historical terminals keep their own state.
function! PortablePracticeStatus() abort
    let l:id = get(b:, 'portable_practice_id', 0)
    if l:id
        for l:r in s:practice_history
            if l:r.id == l:id
                return l:r.phase ==# 'running' ? ' [Running #' . l:id . ']'
                            \ : printf(' [%s #%d · exit %d]', l:r.status == 0 ? 'Done' : 'Failed', l:id, l:r.status)
            endif
        endfor
        return ''
    endif
    let l:r = get(s:practice, 'state', {})
    if &buftype ==# '' && bufnr('%') == get(l:r, 'source_buffer', -1)
        return get(l:r, 'phase', '') ==# 'compiling' ? ' [Practice: compiling]'
                    \ : get(l:r, 'phase', '') ==# 'running' ? ' [Practice: running]' : ''
    endif
    return ''
endfunction
" A dedicated terminal layout avoids code metadata and Vim's duplicate finished flag.
function! PortablePracticeStatusline() abort
    " %! expressions run in the current window, which may be the source pane.
    let l:win = get(getwininfo(get(g:, 'statusline_winid', win_getid())), 0, {})
    let l:r = getbufvar(get(l:win, 'bufnr', bufnr('%')), 'portable_practice_record', {})
    if empty(l:r)
        return '%#StatuslineFlag# Practice output'
    endif
    " This function returns a statusline format: escape percent signs in filenames.
    let l:name = substitute(fnamemodify(l:r.source, ':t'), '%', '%%', 'g')
    let l:state = l:r.phase ==# 'running' ? 'Running'
                \ : printf('%s · exit %d', l:r.status == 0 ? 'Done' : 'Failed', l:r.status)
    return printf('%%#StatuslineFlag# Practice #%d  %%#StatuslineFileName#%s  %%#StatuslineFileType#[%s]%%#StatuslineFill#%%<%%=%%#StatuslineHostName# %s ', l:r.id, l:name,
                \ l:r.checked ? 'Sanitizer' : 'Normal', l:state)
endfunction
function! s:PracticeStatusAttach() abort
    let l:dedicated = '%!PortablePracticeStatusline()'
    if get(b:, 'portable_practice_id', 0)
        if &l:statusline !=# l:dedicated
            let w:portable_practice_previous_statusline = &l:statusline
            let &l:statusline = l:dedicated
        endif
        return
    endif
    " A result pane can be reused for source code; restore its normal layout.
    if &l:statusline ==# l:dedicated
        let &l:statusline = get(w:, 'portable_practice_previous_statusline', &g:statusline)
    endif
    " Preserve ManShow's layout and highlights, even when it rebuilds the line.
    let l:line = &statusline
    if stridx(l:line, 'PortablePracticeStatus()') < 0
        let &l:statusline = l:line . '%#StatuslinePracticeStatus#%{PortablePracticeStatus()}%0*'
    endif
endfunction
augroup PortableVimPracticeStatus
    autocmd!
    autocmd OptionSet statusline call <SID>PracticeStatusAttach()
    autocmd VimEnter,BufWinEnter * call <SID>PracticeStatusAttach()
augroup END
function! s:PracticeHistoryChanged() abort
    let l:limit = get(g:, 'portable_practice_history_limit', 10)
    let l:limit = type(l:limit) == v:t_number && l:limit > 0 ? l:limit : 10
    while len(s:practice_history) > l:limit
        let l:index = -1
        for l:i in range(len(s:practice_history))
            if s:practice_history[l:i].phase ==# 'run'
                let l:index = l:i
                break
            endif
        endfor
        if l:index < 0
            break
        endif
        let l:old = remove(s:practice_history, l:index)
        " Do not close visible history or discard a user's edits to old output.
        if bufexists(l:old.terminal) && empty(win_findbuf(l:old.terminal))
                    \ && !getbufvar(l:old.terminal, '&modified')
            execute 'silent! bwipeout! ' . l:old.terminal
        endif
    endwhile
    let g:portable_vim_practice_history = deepcopy(s:practice_history)
    redrawstatus!
endfunction
function! s:PracticeResultPane(context) abort
    for l:id in keys(s:practice_windows)
        let l:win = win_id2win(str2nr(l:id))
        if l:win && s:practice_windows[l:id].origin == a:context.origin
                    \ && getbufvar(winbufnr(l:win), 'portable_practice_id', 0)
            call win_gotoid(str2nr(l:id))
            return 1
        endif
    endfor
    call s:PracticeReturnToSource(a:context, 0)
    if &buftype !=# ''
        echom 'No code window available for practice results in this tab'
        return 0
    endif
    belowright new
    return 1
endfunction
function! s:PracticeReturnToSource(context, timer) abort
    " Stay in the current tab; a source window may have closed during the run.
    let l:origin = win_id2win(a:context.origin)
    if l:origin && winbufnr(l:origin) == a:context.source_buffer
                \ && getbufvar(a:context.source_buffer, '&buftype') ==# ''
        call win_gotoid(a:context.origin)
        return
    endif
    let l:fallback = 0
    for l:win in getwininfo()
        if l:win.tabnr != tabpagenr() || getbufvar(l:win.bufnr, '&buftype') !=# ''
                    \ || getwinvar(l:win.winnr, '&previewwindow')
            continue
        endif
        if l:win.bufnr == a:context.source_buffer
            call win_gotoid(l:win.winid)
            return
        endif
        let l:fallback = l:fallback ? l:fallback : l:win.winid
    endfor
    if l:fallback
        call win_gotoid(l:fallback)
    endif
endfunction
function! s:PracticeWindowClosed(id) abort
    if !has_key(s:practice_windows, a:id)
        return
    endif
    let l:context = remove(s:practice_windows, a:id)
    " WinClosed precedes Vim's selection of the next window; restore afterwards.
    " Closing a background result window must not move the user's cursor.
    if s:practice_active_window == str2nr(a:id) && getbufvar(bufnr('%'), 'portable_practice_id', 0)
        call timer_start(0, function('<SID>PracticeReturnToSource', [l:context]))
    endif
endfunction
augroup PortableVimPracticeWindows
    autocmd!
    " win_execute() changes context without WinEnter; keep the actual focus.
    autocmd WinEnter * let s:practice_active_window = win_getid()
    if exists('##WinClosed')
        autocmd WinClosed * call <SID>PracticeWindowClosed(expand('<amatch>'))
    endif
augroup END
function! s:PracticeExited(context, job, status) abort
    let a:context.status = a:status
    let a:context.phase = 'run'
    let g:portable_vim_practice_result = copy(a:context)
    call s:PracticeHistoryChanged()
    redrawstatus!
    echom 'Practice finished: exit ' . a:status
endfunction
function! s:PracticeCompiled(context, result) abort
    let s:practice.state = extend(copy(a:context), {'phase': 'compile'})
    redrawstatus!
    let g:portable_vim_practice_result = extend(copy(a:context), {'status': a:result.status, 'phase': 'compile'})
    " Close only this practice list, and never a window inherited from another tool.
    let l:qf = getqflist({'id': 0, 'winid': 0})
    if a:result.status == 0 && !get(a:result, 'stopped', 0)
                \ && l:qf.id == a:result.qfid && l:qf.winid
                \ && (a:context.close_quickfix || l:qf.winid != a:context.quickfix_window)
        let l:items = getqflist({'id': a:result.qfid, 'items': 0}).items
        if empty(filter(l:items, 'v:val.valid'))
            cclose
        endif
    endif
    if a:result.status || get(a:result, 'stopped', 0) || !a:context.run
        if a:result.status && !get(a:result, 'stopped', 0)
            call s:BuildResults()
        endif
        return
    endif
    if !executable(a:context.output)
        let g:portable_vim_practice_result.status = -1
        echom 'Practice executable missing or not executable: ' . a:context.output
        return
    endif
    " Check again: the input file may have disappeared while compiling.
    if !empty(a:context.input) && !filereadable(a:context.input)
        echom 'Practice input disappeared: ' . a:context.input
        return
    endif
    if !s:PracticeResultPane(a:context)
        return
    endif
    " Hide, rather than overwrite, the previous completed terminal buffer.
    hide enew
    setlocal termwinsize=10*0
    let l:record = extend(copy(a:context), {'id': s:practice_next_id,
                \ 'time': strftime('%Y-%m-%d %H:%M:%S'), 'terminal': 0,
                \ 'phase': 'running', 'status': 'running'})
    let s:practice_next_id += 1
    call add(s:practice_history, l:record)
    let s:practice.state = l:record
    let g:portable_vim_practice_result = copy(l:record)
    " Keep results visible, but do not reopen a window the user has closed.
    " Use the theme's Normal colors instead of a separate Terminal background.
    " Keep the ANSI palette intact for colored program/sanitizer output.
    let l:opts = {'cwd': a:context.root, 'curwin': 1, 'term_highlight': 'Normal',
                \ 'term_name': 'Practice #' . l:record.id . ': ' . fnamemodify(a:context.source, ':t'),
                \ 'exit_cb': function('<SID>PracticeExited', [l:record])}
    if !empty(a:context.input)
        let l:opts.in_io = 'file'
        let l:opts.in_name = a:context.input
    endif
    let l:buf = term_start([a:context.output], l:opts)
    if l:buf <= 0
        let s:practice.state = {}
        call remove(s:practice_history, -1)
        call s:PracticeHistoryChanged()
        close
        echom 'Could not start practice program'
        return
    endif
    let l:record.terminal = l:buf
    call setbufvar(l:buf, 'portable_practice_record', l:record)
    call setbufvar(l:buf, 'portable_practice_id', l:record.id)
    call s:PracticeStatusAttach()
    call setbufvar(l:buf, '&bufhidden', 'hide')
    let s:practice_windows[string(win_getid())] = a:context
    let s:practice.run_job = term_getjob(l:buf)
    let g:portable_vim_practice_result = copy(l:record)
    call s:PracticeHistoryChanged()
endfunction
function! s:PracticeHistoryIds(A, L, P) abort
    return join(map(reverse(copy(s:practice_history)), 'string(v:val.id)'), "\n")
endfunction
function! s:PracticeHistory(id) abort
    if empty(s:practice_history)
        echom 'No practice history; use :PracticeRun first'
        return
    endif
    let l:records = reverse(copy(s:practice_history))
    if empty(a:id)
        let l:menu = ['Select practice output (0 cancels):']
        for l:i in range(len(l:records))
            let l:r = l:records[l:i]
            call add(l:menu, printf('%d. #%d %s %s [%s] exit=%s', l:i + 1,
                        \ l:r.id, l:r.time, fnamemodify(l:r.source, ':t'),
                        \ l:r.checked ? 'sanitizer' : 'normal', string(l:r.status)))
        endfor
        let l:choice = inputlist(l:menu)
        if l:choice <= 0 || l:choice > len(l:records)
            return
        endif
        let l:record = l:records[l:choice - 1]
    else
        let l:matches = filter(l:records, 'string(v:val.id) ==# a:id')
        if empty(l:matches)
            echoerr 'Unknown practice history ID: ' . a:id
            return
        endif
        let l:record = l:matches[0]
    endif
    if !bufexists(l:record.terminal)
        echoerr 'Practice output buffer was deleted'
        return
    endif
    if s:PracticeResultPane(l:record)
        execute 'hide buffer ' . l:record.terminal
        call s:PracticeStatusAttach()
        let s:practice_windows[string(win_getid())] = l:record
    endif
endfunction
function! s:Practice(run, checked, input, ...) abort
    if get(s:build, 'running', 0) || (has_key(s:practice, 'run_job') && job_status(s:practice.run_job) ==# 'run')
        echoerr 'A build or practice program is running; stop it first'
        return
    endif
    if &buftype !=# '' || index(['c', 'cpp'], &filetype) < 0 || !filereadable(expand('%:p'))
        echoerr 'Open a saved C/C++ source file for practice'
        return
    endif
    if &modified
        echoerr 'Save the source with :write before practice compilation'
        return
    endif
    if a:run && !exists('*term_start')
        echoerr 'PracticeRun requires Vim terminal support'
        return
    endif
    let l:input = empty(a:input) ? '' : fnamemodify(expand(a:input), ':p')
    if !empty(l:input) && !filereadable(l:input)
        echoerr 'Practice input does not exist: ' . l:input
        return
    endif
    " An explicit buffer-local dictionary enables Makefile builds; never auto-detect.
    let l:make = get(b:, 'portable_practice_make', {})
    if type(l:make) != v:t_dict
        echoerr 'b:portable_practice_make must be a dictionary'
        return
    endif
    let l:root = expand('%:p:h')
    if !empty(l:make)
        let l:output = get(l:make, a:checked ? 'checked_output' : 'output', get(l:make, 'output', ''))
        let l:file = get(l:make, 'file', 'Makefile')
        let l:program = get(l:make, 'program', 'make')
        let l:target = get(l:make, a:checked ? 'checked_target' : 'target', '')
        let l:args = get(l:make, 'args', [])
        if type(l:output) != v:t_string || empty(l:output)
                    \ || type(l:file) != v:t_string || empty(l:file)
                    \ || type(l:program) != v:t_string || type(l:target) != v:t_string
                    \ || type(l:args) != v:t_list || !empty(filter(copy(l:args), 'type(v:val) != v:t_string'))
            echoerr 'Practice Makefile mode requires output, string file/program/target, and a list of string args'
            return
        endif
        if a:checked && empty(l:target)
            echoerr 'PracticeRun! Makefile mode requires checked_target; enable sanitizers in that Makefile target'
            return
        endif
        if !executable(l:program) || !filereadable(l:root . '/' . l:file)
            echoerr 'Practice Makefile or make executable unavailable'
            return
        endif
        " Resolve configured output relative to the source directory, without :cd.
        let l:output = simplify(l:output =~# '^\%(/\|[A-Za-z]:[/\\]\|\\\\\)' ? l:output : l:root . '/' . l:output)
        let l:argv = [exepath(l:program), '-f', l:file] + copy(l:args)
        if !empty(l:target)
            call add(l:argv, l:target)
        endif
    else
        let l:cpp = &filetype ==# 'cpp'
        let l:compiler = get(b:, 'portable_practice_compiler', get(g:, 'portable_practice_' . (l:cpp ? 'cxx' : 'cc'), l:cpp ? 'clang++' : 'clang'))
        if !executable(l:compiler)
            echoerr 'Practice compiler unavailable: ' . l:compiler
            return
        endif
        let l:flags = get(b:, 'portable_practice_flags', [])
        if type(l:flags) != v:t_list || !empty(filter(copy(l:flags), 'type(v:val) != v:t_string'))
            echoerr 'b:portable_practice_flags must be a list of compiler arguments'
            return
        endif
        " Explicit outputs are relative to the source directory, not Vim's cwd.
        let l:output = a:0 ? a:1 : get(b:, a:checked ? 'portable_practice_checked_output' : 'portable_practice_output',
                    \ get(b:, 'portable_practice_output', ''))
        if type(l:output) != v:t_string
            echoerr 'Practice output must be a string path'
            return
        endif
        if empty(l:output)
            let l:output = tempname() . '/practice' . (s:windows ? '.exe' : '')
        else
            let l:output = simplify(l:output =~# '^\%(/\|[A-Za-z]:[/\\]\|\\\\\)' ? l:output : l:root . '/' . l:output)
        endif
        if isdirectory(l:output) || resolve(l:output) ==# resolve(expand('%:p'))
            echoerr 'Practice output must be a file distinct from the source'
            return
        endif
        try
            call mkdir(fnamemodify(l:output, ':h'), 'p')
        catch
            echoerr 'Could not create practice output directory: ' . v:exception
            return
        endtry
        let l:argv = [exepath(l:compiler), '-std=' . get(b:, 'portable_practice_standard', l:cpp ? 'c++17' : 'c17'),
                    \ '-Wall', '-Wextra', '-Wshadow', '-g', '-O0', '-fdiagnostics-color=never']
        if a:checked
            call extend(l:argv, ['-fsanitize=address,undefined', '-fno-omit-frame-pointer', '-fno-sanitize-recover=all'])
        endif
        call extend(l:argv, copy(l:flags) + [expand('%:p'), '-o', l:output])
    endif
    let l:ctx = {'source': expand('%:p'), 'root': l:root, 'output': l:output,
                \ 'input': l:input, 'run': a:run, 'checked': a:checked, 'make_mode': !empty(l:make),
                \ 'origin': win_getid(), 'source_buffer': bufnr('%')}
    let l:qf = getqflist({'winid': 0, 'title': 0})
    let l:ctx.quickfix_window = l:qf.winid
    let l:ctx.close_quickfix = l:qf.title =~# '^Practice: '
    " Preserve this buffer's compiler settings while obtaining GCC/Clang parsing.
    let l:old_efm = &l:errorformat
    let l:old_make = &l:makeprg
    let l:had_compiler = exists('b:current_compiler')
    let l:old_compiler = get(b:, 'current_compiler', '')
    try
        compiler gcc
        let l:efm = &errorformat
    finally
        let &l:errorformat = l:old_efm
        let &l:makeprg = l:old_make
        if l:had_compiler
            let b:current_compiler = l:old_compiler
        else
            unlet! b:current_compiler
        endif
    endtry
    call s:StartBuild(join(map(copy(l:argv), 'shellescape(v:val)'), ' '), l:ctx.root, l:efm, 'Practice: ' . fnamemodify(l:ctx.source, ':t'),
                \ {'argv': l:argv, 'on_complete': function('<SID>PracticeCompiled', [l:ctx])})
    let s:practice.state = extend(copy(l:ctx), {'phase': 'compiling'})
    let s:practice.compile_job = s:build.job
    redrawstatus!
endfunction
function! s:PracticeStop() abort
    if has_key(s:practice, 'compile_job') && job_status(s:practice.compile_job) ==# 'run'
        " The practice compiler shares the build queue and its cancellation flag.
        call s:BuildStop()
    endif
    if has_key(s:practice, 'run_job') && job_status(s:practice.run_job) ==# 'run'
        call job_stop(s:practice.run_job)
    endif
endfunction
" -o takes a directory relative to Vim's effective cwd for this invocation only.
" <f-args> handles Vim-style escaped spaces; no shell parses these paths.
function! s:PracticeCommand(run, checked, args) abort
    let l:args = copy(a:args)
    if empty(l:args) || l:args[0] !=# '-o'
        if !a:run && !empty(l:args)
            echoerr 'Usage: PracticeBuild[!] [-o directory]'
            return
        endif
        if !empty(l:args) && l:args[0] ==# '--'
            call remove(l:args, 0)
        endif
        call s:Practice(a:run, a:checked, join(l:args, ' '))
        return
    endif
    if len(l:args) < 2 || empty(l:args[1]) || len(l:args) > (a:run ? 3 : 2)
        echoerr 'Usage: PracticeRun[!] -o directory [input-file] / PracticeBuild[!] -o directory'
        return
    endif
    if !empty(get(b:, 'portable_practice_make', {}))
        echoerr 'Practice -o is for single-file mode; configure Makefile output in b:portable_practice_make'
        return
    endif
    let l:directory = fnamemodify(l:args[1], ':p')
    if filereadable(l:directory)
        echoerr 'Practice -o requires an output directory'
        return
    endif
    let l:output = simplify(l:directory . '/' . expand('%:t:r') . (s:windows ? '.exe' : ''))
    call s:Practice(a:run, a:checked, get(l:args, 2, ''), l:output)
endfunction
