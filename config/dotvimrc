" Explicit debugger console; argv avoids shell interpretation of program paths.
function! s:DebugProgram(file) abort
    if !exists('*term_start')
        echohl WarningMsg | echom 'DebugProgram requires Vim terminal support' | echohl None
        return
    endif
    let l:file = fnamemodify(a:file, ':p')
    if !filereadable(l:file)
        echohl WarningMsg | echom 'Debug program not found: ' . l:file | echohl None
        return
    endif
    let l:debugger = get(g:, 'portable_vim_debugger', '')
    if empty(l:debugger)
        for l:candidate in (s:mac ? ['lldb', 'gdb'] : ['gdb', 'lldb'])
            if executable(l:candidate)
                let l:debugger = exepath(l:candidate)
                break
            endif
        endfor
    endif
    if empty(l:debugger) || !executable(l:debugger)
        echohl WarningMsg | echom 'No GDB/LLDB debugger found; set g:portable_vim_debugger' | echohl None
        return
    endif
    botright new
    let l:opts = {'curwin': 1, 'term_highlight': 'Normal',
                \ 'term_name': 'Debugger: ' . fnamemodify(l:file, ':t'),
                \ 'term_finish': 'open'}
    " A user palette overrides the active theme palette.  Restrict this to
    " debugger terminals so program and sanitizer ANSI output stays unchanged.
    let l:palette = get(g:, 'portable_vim_debugger_ansi_colors',
                \ get(g:, 'portable_vim_debugger_theme_ansi_colors', []))
    if type(l:palette) == v:t_list && len(l:palette) == 16
        let l:opts.ansi_colors = copy(l:palette)
    endif
    let l:buffer = term_start([l:debugger, '--', l:file], l:opts)
    if l:buffer == 0
        close
        echohl WarningMsg | echom 'Failed to start debugger' | echohl None
    endif
endfunction
