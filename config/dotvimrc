" Explicit whitespace cleanup preserves Markdown hard breaks until requested.
function! s:TrimWhitespace() abort
    if !&modifiable || &binary || &filetype ==# 'diff'
        return
    endif
    let l:view = winsaveview()
    try
        let l:lines = getline(1, '$')
        let l:clean = map(copy(l:lines), 'substitute(v:val, "\\s\\+$", "", "")')
        if l:clean !=# l:lines
            call setline(1, l:clean)
        endif
    finally
        call winrestview(l:view)
    endtry
endfunction
command! TrimWhitespace call <SID>TrimWhitespace()

" Universal and Exuberant ctags both accept these options (no obsolete extras).
function! s:BuildTags() abort
    if !executable('ctags')
        echoerr 'ctags is not in PATH'
        return
    endif
    let l:version = system('ctags --version')
    if l:version !~# '\(Universal\|Exuberant\) Ctags'
        echoerr 'Install Universal or Exuberant ctags; system BSD ctags is unsupported'
        return
    endif
    let l:output = system('ctags -R --c-kinds=+p --c++-kinds=+p --fields=+iaS .')
    if v:shell_error
        echoerr l:output
    else
        echom 'Updated tags in ' . getcwd()
    endif
endfunction
command! BuildTags call <SID>BuildTags()
nnoremap <F12> :BuildTags<CR>
nnoremap <C-F12> :BuildTags<CR>

function! s:RestorePosition() abort
    if &buftype ==# '' && &filetype !~# '^\(gitcommit\|gitrebase\)$'
        let l:line = line("'\"")
        if l:line > 0 && l:line <= line('$')
            normal! g`"
        endif
    endif
endfunction
" Diagnose search-limit effects without reindenting the buffer. A long block
" alone is not an error: warn only if a longer search changes cindent().
function! s:CheckCIndentLimit(manual) abort
    if &buftype !=# '' || &filetype !~# '^\%(c\|cpp\)$'
                \ || !&l:cindent || !empty(&l:indentexpr) || !empty(&l:equalprg)
        if a:manual
            echom 'CIndentCheck requires C/C++ with builtin cindent'
        endif
        return
    endif
    let l:key = [b:changedtick, line('.'), &l:cinoptions]
    if !a:manual && get(b:, 'portable_cindent_last_check', []) ==# l:key
        return
    endif
    let b:portable_cindent_last_check = l:key
    let l:original = &l:cinoptions
    let l:options = split(l:original, ',')
    let l:limits = []
    for l:i in range(len(l:options))
        if l:options[l:i] =~# '^[)*][0-9]\+$'
            let l:limit = str2nr(strpart(l:options[l:i], 1))
            if l:limit > 0 && l:limit < line('.')
                call add(l:limits, l:options[l:i])
                let l:options[l:i] = strpart(l:options[l:i], 0, 1) . line('.')
            endif
        endif
    endfor
    let l:normal = cindent(line('.'))
    let l:extended = l:normal
    if !empty(l:limits)
        try
            let &l:cinoptions = join(l:options, ',')
            let l:extended = cindent(line('.'))
        finally
            let &l:cinoptions = l:original
        endtry
    endif
    if l:normal != l:extended
        echohl WarningMsg
        echom printf('C indent: line %d may exceed search limits [%s]: %d -> %d columns with longer search',
                    \ line('.'), join(l:limits, ','), l:normal, l:extended)
        echohl None
    elseif a:manual
        echom 'C indent: no search-limit difference detected on the current line'
    endif
endfunction
command! CIndentCheck call <SID>CheckCIndentLimit(1)
