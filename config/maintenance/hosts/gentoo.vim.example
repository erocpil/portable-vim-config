" Gentoo host overrides for the shared Vim configuration.
let g:portable_laos_root = expand('~/src/laos')
let g:portable_llvm_bin = '/usr/lib/llvm/20/bin'
if executable(g:portable_llvm_bin . '/clangd')
    let g:ycm_clangd_binary_path = g:portable_llvm_bin . '/clangd'
endif
if executable(g:portable_llvm_bin . '/clang')
    let g:portable_practice_cc = g:portable_llvm_bin . '/clang'
endif
if executable(g:portable_llvm_bin . '/clang++')
    let g:portable_practice_cxx = g:portable_llvm_bin . '/clang++'
endif
" The installed Gentoo ycmd native module was built for Linux Python 3.13.
let g:ycm_server_python_interpreter = '/usr/bin/python3.13'
